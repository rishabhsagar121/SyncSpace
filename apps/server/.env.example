NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Postgres connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncspace?schema=public"

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_URL=redis://localhost:6379

# Cloudinary (for avatar/message file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=